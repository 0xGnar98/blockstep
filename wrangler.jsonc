{
  "name": "blockstep",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "HEMI_RPC_URL": "https://rpc.hemi.network/rpc",
    "SCORE_CONTRACT_ADDRESS": "0x302449c0dcC71c6ef04820D6c55Cc316fAF15457",
    "ALLOWED_ORIGINS": "",
    "RELAYER_MAX_GAS": "700000",
    "RELAYER_MAX_FEE_PER_GAS_WEI": "2000000"
  }
}
